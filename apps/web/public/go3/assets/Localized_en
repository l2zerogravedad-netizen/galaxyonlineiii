// 新手引導
GuideManName1 = "Pirate Barbarossa";
GuideManName2 = "Captain Alie";
GuideManName3 = "Lieutenant Wells";
GuideManName4 = "General Verne";

GuideText0_1 = "This is bad! Our radar has detected a breach in our borders… It's the Corsairs!";
GuideText0_2 = "Impossible! They've been in exile for over 10 years!";
GuideText0_3 = "These space scum dare try to swipe our resources? This is Federation space! You outlaws have no right being here!";
GuideText0_4 = "Outlaws? Might makes right, General! I'm the law now!";
GuideText0_5 = "Don't make me laugh! All ships, fly into formation!";
GuideText0_6 = "We reigned over the cosmos and every star in the sky. We were the spark of civilization!";
GuideText0_7 = "What's this? I've never seen an energy shield with this much power!";
GuideText0_8 = "Peace has made you lazy, General! While you were twiddling your thumbs, we've been gearing up for war! We wield technology that's lightyears more advanced than yours!";
GuideText0_9 = "Someone destroyed Wagner's fleet! Did that attack come from our ships? Hold your fire!";
GuideText0_10 = "A ceasefire? What makes you think we'll abide to that? Count your lucky stars that you're not part of our plans today! Enjoy your last moments of peace!";
GuideText0_11 = "General, they're in full retreat! Should we set a pursuit course?";
GuideText0_12 = "Hold steady, Lieutenant. If the Corsairs are back, we must report to HQ at once!";

GuideText1_1 = "The peace that we sustained for so many years was shattered in a single moment. With you as my prodigy, we must restore peace to these troubled skies. My assistant, Captain Alie, will guide you in your quest.";
GuideText1_2 = "Nice to meet you! How may I address you, Commander?";
GuideText50_1 = "Commander %s, you carry a name that's burdened with vengeance and glorious purpose! This planetary base will be a platform for you conquests. Manage it well. I will aid you every step of the way!";

GuideText2_1 = "This is our base of operations. We may have defeated the space pirates but we have only earned a mere respite. They will return.";
GuideText2_2 = "The protection and expansion of our base depends on the strength of our <font color='#00ff00'>Ships</font>. <font color='#ffa306'>Tap the highlighted area</font> to build a <font color='#00ff00'>Shipyard</font>.";
GuideText2_3 = "Tasks are added to your <font color='#00ff00'>Construction Schedule</font> each time you construct a new building or upgrade an existing one. If the <font color='#00ff00'>Construction Schedule</font> is full, you must wait for a current task finish before starting another.";
GuideText2_4 = "Now that your <font color='#00ff00'>Shipyard</font> is complete, we can begin manufacturing ships to defend against enemy attacks.";

GuideText3_1 = "Greetings, Commander. I'm Captain Alie. Although we've managed to repel the corsairs, I believe it is a matter of time before they launch a second assault on our base.";
GuideText3_2 = "We need to get a strong armada of fleets airborne ASAP. Let’s visit the Ship Factory right away.";
GuideText3_3 = "You can complete these ships instantly by tapping the Finish Now button. Let's give it a try.";

GuideText4_1 = "At the heart of every mighty <font color='#00ff00'>fleet</font> is a qualified <font color='#00ff00'>Captain</font>. Tap the <font color='#ffa306'>highlighted area</font> and build an <font color='#00ff00'>Academy</font>.";
GuideText4_2 = "Now that the <font color='#00ff00'>Academy</font> is complete, you can hire some of the finest Captains in the galaxy for your fleets.";

GuideText5_1 = "Our fleets need talented Captains to lead them into battle. Let's head to the Academy and recruit some right now.";

GuideText6_1 = "With new <font color='#00ff00'>Ships</font> and <font color='#00ff00'>Captains</font>, you can create a fleet of your very own. <font color='#ffa306'>Tap</font><font color='#00ff00'> Fleet</font> in the Main Menu to continue.";
GuideText6_2 = "<font color='#ffa306'>Tap</font> the empty slot to build new fleet.";
GuideText6_3 = "Next, <font color='#ffa306'>pick a Captain</font> to lead your new <font color='#00ff00'>fleet</font>.";
GuideText6_4 = "Now let's assemble a fleet. We can select the <font color='#00ff00'>type</font> and<font color='#00ff00'> number of ships.</font>";
GuideText6_5 = "Your Hangar contains <font color='#00ff00'>nine slots</font>. <font color='#ffa306'>Tap one</font> to assign ships to the slot.";
GuideText6_6 = "If you want to view your <font color='#00ff00'>assembled fleets</font>, tap  <font color='#00ff00'>All Fleets</font>. Congrats, we're now ready to take on the Corsairs!";
GuideText7_1 = "Now that your fleets are prepared, it's time to fight the Corsairs.";
GuideText7_2 = "Battles consume <font color='#00ff00'>CP</font>. If your <font color='#00ff00'>CP</font> is too low, you can't participate in combat. <font color='#00ff00'>CP</font> slowly recovers over time but can be instantly recovered with <font color='#ffa306'>Space Bux</font>.";
GuideText7_3 = "<font color='#ffa306'>Tap the fleets</font> you wish you deploy.";
GuideText8_1 = "The pirates will be back soon. Tap <font color='#ffa306'>highlighted area</font> to build your <font color='#00ff00'>Resource Buildings</font>.";
GuideText8_2 = "Let's build a <font color='#00ff00'>Metal Extractor</font> first. Metal Extractors produce <font color='#00ff00'>Metal</font> at fixed intervals. <font color='#ffa306'>Tap</font> to build a Metal Extractor.";
GuideText9_1 = "Well done, we will now build a <font color='#00ff00'>He3 Mine</font>.<br> The mine produces<font color='#00ff00'>He3</font> for construction and ship fuel. <font color='#ffa306'>Tap here </font> to build a He3 Mine.";
GuideText10_1 = "Finally, let's build a <font color='#00ff00'>Housing District</font>! Housing Districts help develop your base by taxing <font color='#00ff00'>Gold</font> from residents. Tap the indicated area to build a Housing District. <font color='#ffa306'>Tap the ‘Construct' button</font> to begin.";
GuideText10_2 = "Gold, Metal, and He3 are needed to build your base or army. With more resource production buildings, you'll be able to build more fleets.";

GuideText11_1 = ""General Verne will no doubt be proud of the way you completed this mission! How shall I address you, Commander?"";

GuideText101_1 = "Commander, we need to develop our base before the Corsairs launch another attack. Let's check what tasks are available.";
GuideText101_2 = "Tap <font color='#00ff00'>Proceed</font> to go to the next step of the Task.";

GuideText102_1 = "You've completed a Main Task. Return to Base and claim your reward!";

GuideText103_1 = "Commander, you may claim your reward by tapping the Task icon.";
GuideText103_2 = "Tap <font color='#00ff00'>Complete</font> to finish a mission and claim your reward!";

GuideText105_1 = "This is where the cream of the crop gathers, where skills and experience determine victory or defeat. Defeat your rivals and rise through the Divisions! Do you have the guts to compete for honor?";
GuideText105_2 = "You need to select at least one fleet to participate in the Federation League. Tap Fleet to make your selection.";
GuideText105_3 = "Tap the Captain whose fleet you wish to use. To confirm your selection, tap Save Fleet.";
GuideText105_4 = "Commander, your fleets are ready. Tap Join to enter.";

GuideText106_1 = "With a completed Radar, you can scan for enemy players, lay siege to their bases, and plunder their resources. Try it out!";
GuideText106_2 = "Tap Enter to access the Radar.";

GuideText107_1 = "A fully operational Trade Center grants access to both the Resource Exchange and the Black Market. Enter the Trade Center to access!";
GuideText107_2 = "Tap Enter to access the Trade Center.";
GuideText107_3 = "Many Commanders who are unsanctioned by the Federation still choose to trade in the Black Market. The resources there can determine a mission's failure or success.";

GuideText231_1 = "Welcome to the Academy's Genesis Chambers. You can generate or convert Captains here.";
GuideText231_2 = "Congratulations! Your first experiment was a success! Feel free to Generate more. You might discover something unexpected!";

